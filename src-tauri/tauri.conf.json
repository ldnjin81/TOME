{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOME",
  "version": "0.1.0",
  "identifier": "dev.ldnjin.tome",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "TOME",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ldnjin81",
    "copyright": "Copyright (c) 2026 ldnjin81. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "A desktop client for the Lore version control system",
    "longDescription": "TOME (Track, Own, Merge, Explore) is a community desktop client for Lore, the version control system by Epic Games: a Smartlog of your stack, branches and merges, locks, artist mode with Unreal asset thumbnails, and restack by drag and drop. Not made or endorsed by Epic Games.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
